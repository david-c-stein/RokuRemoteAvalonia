<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             x:Class="RokuRemoteAvalonia.Controls.RokuKeyboard"
             x:DataType="controls:RokuKeyboard"
             xmlns:controls="using:RokuRemoteAvalonia.Controls">

    <Border Background="#2B2B35" 
            BorderBrush="#3A3A44" 
            BorderThickness="2" 
            CornerRadius="15" 
            Padding="20">
        <StackPanel Spacing="15">
            
            <!-- Dynamic Title -->
            <TextBlock Text="{Binding Title}" 
                       FontSize="18" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Foreground="White"/>

            <!-- Text Display - Only show in dialog mode -->
            <Border Background="#1A1A24" 
                    BorderBrush="#4A4A54" 
                    BorderThickness="2" 
                    CornerRadius="8" 
                    Padding="15,10" 
                    MinHeight="40"
                    IsVisible="{Binding ShowOkCancel}">
                <ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding Text}" 
                               FontSize="16" 
                               Foreground="White" 
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </ScrollViewer>
            </Border>

            <!-- Keyboard Layout -->
            <StackPanel Spacing="5">
                
                <!-- Number Row -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="2">
                    <Button Content="`" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="1" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="2" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="3" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="4" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="5" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="6" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="7" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="8" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="9" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="0" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="-" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="=" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                </StackPanel>

                <!-- First Letter Row -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="2">
                    <Button Content="TAB" Click="OnTabClick"
                            Width="55" Height="40" Margin="1" FontSize="10" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="q" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="w" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="e" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="r" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="t" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="y" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="u" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="i" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="o" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="p" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="[" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="]" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="\" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                </StackPanel>

                <!-- Second Letter Row -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="2">
                    <Button Content="{Binding ShiftButtonText}" Click="OnShiftClick"
                            Width="70" Height="40" Margin="1" FontSize="10" FontWeight="Bold"
                            Background="#5A5A64" Foreground="White" BorderBrush="#7A7A84"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="a" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="s" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="d" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="f" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="g" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="h" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="j" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="k" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="l" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content=";" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="'" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="ENTER" Click="OnEnterClick"
                            Width="75" Height="40" Margin="1" FontSize="10" FontWeight="Bold"
                            Background="#5A5A64" Foreground="White" BorderBrush="#7A7A84"
                            BorderThickness="1" CornerRadius="6"/>
                </StackPanel>

                <!-- Third Letter Row -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="2">
                    <Button Content="{Binding ShiftButtonText}" Click="OnShiftClick"
                            Width="85" Height="40" Margin="1" FontSize="10" FontWeight="Bold"
                            Background="#5A5A64" Foreground="White" BorderBrush="#7A7A84"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="z" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="x" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="c" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="v" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="b" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="n" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="m" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="," Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="." Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="/" Click="OnKeyClick"
                            Width="40" Height="40" Margin="1" FontSize="14" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="⌫" Click="OnBackspaceClick"
                            Width="85" Height="40" Margin="1" FontSize="12" FontWeight="Bold"
                            Background="#5A5A64" Foreground="White" BorderBrush="#7A7A84"
                            BorderThickness="1" CornerRadius="6"/>
                </StackPanel>

                <!-- Space and Control Row -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5">
                    <Button Content="SPACE" Click="OnSpaceClick"
                            Width="300" Height="40" Margin="2" FontSize="12" FontWeight="Bold"
                            Background="#4A4A54" Foreground="White" BorderBrush="#6A6A74"
                            BorderThickness="1" CornerRadius="6"/>
                    <Button Content="CLR" Click="OnClearClick"
                            Width="60" Height="40" Margin="2" FontSize="10" FontWeight="Bold"
                            Background="#5A5A64" Foreground="White" BorderBrush="#7A7A84"
                            BorderThickness="1" CornerRadius="6"/>
                </StackPanel>

            </StackPanel>

            <!-- Action Buttons - Only show in dialog mode -->
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center" 
                        Spacing="15" 
                        Margin="0,10,0,0"
                        IsVisible="{Binding ShowOkCancel}">
                <Button Content="OK" Click="OnOkClick"
                        Width="70" Height="45" Margin="2" FontSize="12" FontWeight="Bold"
                        Background="#662D91" Foreground="White" BorderBrush="#8A4DC1"
                        BorderThickness="1" CornerRadius="6"/>
                <Button Content="Cancel" Click="OnCancelClick"
                        Width="70" Height="45" Margin="2" FontSize="12" FontWeight="Bold"
                        Background="#D9534F" Foreground="White" BorderBrush="#E57373"
                        BorderThickness="1" CornerRadius="6"/>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>