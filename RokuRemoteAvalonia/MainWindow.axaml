<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:RokuRemoteAvalonia"
        xmlns:roku="using:RRemote.Roku"
		xmlns:dialogHostAvalonia="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="850"
        x:Class="RokuRemoteAvalonia.MainWindow"
        x:DataType="vm:MainWindow"
        Title="Roku Remote Control - Avalonia"
        MinWidth="750" MinHeight="850"
		Width="750" Height="850">

	<Window.Resources>
		<!-- Remote Control Gradient Background -->
		<LinearGradientBrush x:Key="RemoteGradient" StartPoint="0,0" EndPoint="0,1">
			<GradientStop Color="#1E1E28" Offset="0"/>
			<GradientStop Color="#2B2B35" Offset="0.5"/>
			<GradientStop Color="#1A1A24" Offset="1"/>
		</LinearGradientBrush>

		<!-- Button Pressed Effect -->
		<LinearGradientBrush x:Key="ButtonGradient" StartPoint="0,0" EndPoint="0,1">
			<GradientStop Color="#5A5A64" Offset="0"/>
			<GradientStop Color="#4A4A54" Offset="0.5"/>
			<GradientStop Color="#3A3A44" Offset="1"/>
		</LinearGradientBrush>

		<!-- Purple OK Button Gradient -->
		<LinearGradientBrush x:Key="OkButtonGradient" StartPoint="0,0" EndPoint="0,1">
			<GradientStop Color="#7A3DB1" Offset="0"/>
			<GradientStop Color="#662D91" Offset="0.5"/>
			<GradientStop Color="#541D71" Offset="1"/>
		</LinearGradientBrush>

		<!-- Quick Launch Button Gradient -->
		<LinearGradientBrush x:Key="QuickLaunchGradient" StartPoint="0,0" EndPoint="0,1">
			<GradientStop Color="#FF8C42" Offset="0"/>
			<GradientStop Color="#FF7A2B" Offset="0.5"/>
			<GradientStop Color="#E5691A" Offset="1"/>
		</LinearGradientBrush>

		<!-- Top Function Button Gradient -->
		<LinearGradientBrush x:Key="FunctionButtonGradient" StartPoint="0,0" EndPoint="0,1">
			<GradientStop Color="#4169E1" Offset="0"/>
			<GradientStop Color="#3457D5" Offset="0.5"/>
			<GradientStop Color="#2845C9" Offset="1"/>
		</LinearGradientBrush>

		<!-- Record Mode Gradient -->
		<LinearGradientBrush x:Key="RecordGradient" StartPoint="0,0" EndPoint="0,1">
			<GradientStop Color="#FF2C2C" Offset="0"/>
			<GradientStop Color="#E51C1C" Offset="0.5"/>
			<GradientStop Color="#CC0C0C" Offset="1"/>
		</LinearGradientBrush>

		<!-- Review Button Gradient -->
		<LinearGradientBrush x:Key="ReviewGradient" StartPoint="0,0" EndPoint="0,1">
			<GradientStop Color="#4A90E2" Offset="0"/>
			<GradientStop Color="#357ABD" Offset="0.5"/>
			<GradientStop Color="#2A5F8F" Offset="1"/>
		</LinearGradientBrush>

		<!-- Info Button Gradient -->
		<LinearGradientBrush x:Key="InfoButtonGradient" StartPoint="0,0" EndPoint="0,1">
			<GradientStop Color="#17A2B8" Offset="0"/>
			<GradientStop Color="#138496" Offset="0.5"/>
			<GradientStop Color="#0F6674" Offset="1"/>
		</LinearGradientBrush>
		
		<!-- ===== SVG-style Vector Icon Geometries ===== -->
		<StreamGeometry x:Key="SearchGeometry">M15.5,14h-0.79l-0.28-0.27C15.41,12.59 16,11.11 16,9.5 16,5.91 13.09,3 9.5,3S3,5.91 3,9.5 5.91,16 9.5,16c1.61,0 3.09-0.59 4.23-1.57l0.27,0.28v0.79l5,4.99L20.49,19l-4.99-5zM9.5,14C7.01,14 5,11.99 5,9.5S7.01,5 9.5,5 14,7.01 14,9.5 11.99,14 9.5,14z</StreamGeometry>
		<StreamGeometry x:Key="MicrophoneGeometry">M12,14c1.66,0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9,3.34 9,5v6C9,12.66 10.34,14 12,14zM17,11c0,2.76-2.24,5-5,5s-5-2.24-5-5H5c0,3.53 2.61,6.43 6,6.92V21h2v-3.08c3.39-0.49 6-3.39 6-6.92H17z</StreamGeometry>
		<StreamGeometry x:Key="KeyboardGeometry">M20,5H4C2.9,5 2,5.9 2,7v10c0,1.1 0.9,2 2,2h16c1.1,0 2-0.9 2-2V7C22,5.9 21.1,5 20,5zM11,8h2v2h-2V8zM11,11h2v2h-2V11zM8,8h2v2H8V8zM8,11h2v2H8V11zM7,13H5v-2h2V13zM7,10H5V8h2V10zM16,17H8v-2h8V17zM16,13h-2v-2h2V13zM16,10h-2V8h2V10zM19,13h-2v-2h2V13zM19,10h-2V8h2V10z</StreamGeometry>
		<StreamGeometry x:Key="InfoGeometry">M12,2C6.48,2 2,6.48 2,12s4.48,10 10,10 10-4.48 10-10S17.52,2 12,2zM13,17h-2v-6h2V17zM13,9h-2V7h2V9z</StreamGeometry>
		<StreamGeometry x:Key="SettingsGeometry">M19.14,12.94c0.04-0.3 0.06-0.61 0.06-0.94 0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14 0.23-0.41 0.12-0.61l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59 8.12,5.92 7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87C2.62,9.08 2.66,9.34 2.86,9.48l2.03,1.58C4.84,11.36 4.8,11.69 4.8,12s0.02,0.64 0.07,0.94l-2.03,1.58c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22 0.37,0.29 0.59,0.22l2.39-0.96c0.5,0.38 1.03,0.7 1.62,0.94l0.36,2.54c0.05,0.24 0.24,0.41 0.48,0.41h3.84c0.24,0 0.44-0.17 0.47-0.41l0.36-2.54c0.59-0.24 1.13-0.56 1.62-0.94l2.39,0.96c0.22,0.08 0.47,0 0.59-0.22l1.92-3.32c0.12-0.22 0.07-0.47-0.12-0.61L19.14,12.94zM12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6,1.62 3.6,3.6-1.62,3.6-3.6,3.6z</StreamGeometry>
		<StreamGeometry x:Key="PowerGeometry">M13,3h-2v10h2V3zM17.83,5.17l-1.42,1.42C17.99,7.86 19,9.81 19,12c0,3.87-3.13,7-7,7s-7-3.13-7-7c0-2.19 1.01-4.14 2.58-5.42L6.17,5.17C4.23,6.82 3,9.26 3,12c0,4.97 4.03,9 9,9s9-4.03 9-9C21,9.26 19.77,6.82 17.83,5.17z</StreamGeometry>
		<StreamGeometry x:Key="BackGeometry">M20,11H7.83l5.59-5.59L12,4l-8,8 8,8 1.41-1.41L7.83,13H20V11z</StreamGeometry>
		<StreamGeometry x:Key="HomeGeometry">M10,20v-6h4v6h5v-8h3L12,3 2,12h3v8z</StreamGeometry>
		<StreamGeometry x:Key="UpGeometry">M7.41,15.41L12,10.83l4.59,4.58L18,14l-6-6-6,6z</StreamGeometry>
		<StreamGeometry x:Key="DownGeometry">M7.41,8.59L12,13.17l4.59-4.58L18,10l-6,6-6-6z</StreamGeometry>
		<StreamGeometry x:Key="LeftGeometry">M15.41,16.59L10.83,12l4.58-4.59L14,6l-6,6 6,6z</StreamGeometry>
		<StreamGeometry x:Key="RightGeometry">M8.59,16.59L13.17,12 8.59,7.41 10,6l6,6-6,6z</StreamGeometry>
		<StreamGeometry x:Key="StarGeometry">M12,17.27L18.18,21l-1.64-7.03L22,9.24l-7.19-0.61L12,2 9.19,8.63 2,9.24l5.46,4.73L5.82,21z</StreamGeometry>
		<StreamGeometry x:Key="MenuGeometry">M3,18h18v-2H3V18zM3,13h18v-2H3V13zM3,6v2h18V6H3z</StreamGeometry>
		<StreamGeometry x:Key="RewindGeometry">M11,18V6l-8.5,6L11,18zM11.5,18l8.5-6l-8.5-6V18z</StreamGeometry>
		<StreamGeometry x:Key="PlayGeometry">M8,5v14l11-7z</StreamGeometry>
		<StreamGeometry x:Key="FastForwardGeometry">M4,18l8.5-6L4,6V18zM13,6v12l8.5-6L13,6z</StreamGeometry>
		<StreamGeometry x:Key="MuteGeometry">M16.5,12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45,2.45c0.03-0.2 0.05-0.41 0.05-0.63zM19,12c0,0.94-0.2,1.82-0.54,2.64l1.51,1.51C20.63,14.91 21,13.5 21,12c0-4.28-2.99-7.86-7-8.77v2.06c2.89,0.86 5,3.54 5,6.71zM4.27,3L3,4.27 7.73,9H3v6h4l5,5v-6.73l4.25,4.25c-0.67,0.52-1.42,0.93-2.25,1.18v2.06c1.38-0.31 2.63-0.95 3.69-1.81L19.73,21 21,19.73l-9-9L4.27,3zM12,4L9.91,6.09 12,8.18V4z</StreamGeometry>
		<StreamGeometry x:Key="EyeGeometry">M12,4.5C7,4.5 2.73,7.61 1,12c1.73,4.39 6,7.5 11,7.5s9.27-3.11 11-7.5C21.27,7.61 17,4.5 12,4.5zM12,17c-2.76,0-5-2.24-5-5s2.24-5 5-5 5,2.24 5,5-2.24,5-5,5zM12,9c-1.66,0-3,1.34-3,3s1.34,3 3,3 3-1.34 3-3-1.34-3-3-3z</StreamGeometry>
		<StreamGeometry x:Key="RecordGeometry">M12,4c-4.41,0-8,3.59-8,8s3.59,8 8,8 8-3.59 8-8-3.59-8-8-8z</StreamGeometry>
		<StreamGeometry x:Key="VolumeDownGeometry">M18.5,12c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-0.73 2.5-2.25 2.5-4.02zM5,9v6h4l5,5V4L9,9H5z</StreamGeometry>
		<StreamGeometry x:Key="VolumeUpGeometry">M3,9v6h4l5,5V4L7,9H3zm13.5,3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-0.73 2.5-2.25 2.5-4.02zM14,3.23v2.06c2.89,0.86 5,3.54 5,6.71s-2.11,5.85-5,6.71v2.06c4.01-0.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z</StreamGeometry>
	</Window.Resources>

<Window.Styles>
	<!-- Raised 3D look for all remote buttons -->
	<Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Transitions">
			<Transitions>
				<BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.08"/>
			</Transitions>
		</Setter>
		<Setter Property="BoxShadow" Value="0 3 5 0 #66000000, inset 0 1 1 0 #55FFFFFF, inset 0 -2 3 0 #40000000"/>
	</Style>

	<!-- Hover: slightly lift -->
	<Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="BoxShadow" Value="0 5 8 0 #77000000, inset 0 1 1 0 #66FFFFFF, inset 0 -2 3 0 #40000000"/>
	</Style>

	<!-- Pressed: sink the button in -->
	<Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="BoxShadow" Value="inset 0 2 4 0 #90000000"/>
	</Style>
	<Style Selector="Button:pressed">
		<Setter Property="RenderTransform" Value="translateY(1px)"/>
	</Style>
</Window.Styles>

	<dialogHostAvalonia:DialogHost Identifier="MainDialogHost"
									DialogMargin="16"
									dialogHostAvalonia:DialogHostStyle.CornerRadius="8">	
	
	<Grid Name="RootGrid" Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Header Section -->
		<StackPanel Grid.Row="0" Orientation="Vertical" Spacing="10"
					IsVisible="{Binding !IsRemoteOnlyMode}">
			<TextBlock Text="Roku Remote Control" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>

			<!-- Device Discovery -->
			<StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
				<Button Content="Discover Devices" Click="OnDiscoverDevices" Padding="10,5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Discover Roku devices on your network"/>
				<ComboBox Name="DeviceComboBox"
						  ItemsSource="{Binding DiscoveredDevices}"
						  SelectedItem="{Binding SelectedDevice}"
						  MinWidth="250"
						  PlaceholderText="Select a Roku device">
					<ComboBox.ItemTemplate>
						<DataTemplate x:DataType="roku:RokuDevice">
							<TextBlock Text="{Binding model_name}"/>
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>
			</StackPanel>

			<!-- Status Bar -->
			<TextBlock Text="{Binding StatusMessage}"
					   HorizontalAlignment="Center"
					   FontStyle="Italic"
					   Foreground="Gray"/>
		</StackPanel>

		<!-- Main Content -->
		<Grid Name="ContentGrid" Grid.Row="1" Margin="0,20,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="350"/>
				<ColumnDefinition Width="20"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<!-- Roku Remote Panel - Enhanced to look like actual remote -->
<Grid Grid.Column="0" Width="240" Height="632" VerticalAlignment="Top">

	<!-- Body edge / side-wall: darker layer offset down to simulate physical thickness -->
	<Border CornerRadius="15,15,27,27"
			Background="#0C0C12"
			Margin="0,10,0,0"
			BoxShadow="0 24 55 0 #C0000000, 0 6 12 0 #80000000"/>

	<!-- Front face of the remote -->
	<Border Background="{StaticResource RemoteGradient}"
			CornerRadius="15,15,25,25"
			Padding="20,30,20,40"
			IsEnabled="{Binding IsConnected}"
			BorderBrush="#3A3A4A"
			BorderThickness="1"
			Width="240"
			Height="620"
			VerticalAlignment="Top"
			BoxShadow="0 22 50 0 #C0000000, 0 6 12 0 #70000000, inset 0 2 2 0 #4DFFFFFF, inset 0 -5 14 0 #66000000, inset 7 0 16 0 #40000000, inset -7 0 16 0 #40000000">

	<StackPanel Spacing="12" HorizontalAlignment="Center">

					<!-- ROKU Logo Area (also acts as a drag handle when the window is frameless) -->
					<Border Name="RemoteDragHandle"
							Background="#662D91"
							CornerRadius="12"
							Padding="15,6"
							HorizontalAlignment="Center"
							Margin="0,5,0,10"
							PointerPressed="OnRemoteDragHandlePressed">
						<TextBlock Text="ROKU"
								   FontSize="16"
								   FontWeight="Bold"
								   HorizontalAlignment="Center"
								   Foreground="White"
								   LetterSpacing="1"/>
					</Border>

					<!-- Recording Status Banner -->
					<Border Background="{StaticResource RecordGradient}"
							CornerRadius="8"
							Padding="10,5"
							IsVisible="{Binding IsRecording}"
							HorizontalAlignment="Center"
							Margin="0,0,0,5">
						<StackPanel Orientation="Horizontal" Spacing="5">
							<PathIcon Data="{StaticResource RecordGeometry}" Width="14" Height="14" Foreground="White"/>
							<TextBlock Text="{Binding RecordingStatusText}" 
									   FontSize="10" 
									   FontWeight="Bold"
									   Foreground="White" 
									   VerticalAlignment="Center"/>
						</StackPanel>
					</Border>

					<!-- Top Function Buttons Row -->
					<StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" Margin="0,5,0,10">
						<!-- Search Button -->
						<Button Click="OnSearchClick"
								Width="35"
								Height="30"
								Background="{StaticResource FunctionButtonGradient}"
								Foreground="White"
								CornerRadius="8"
								BorderBrush="#5A7FE1"
								BorderThickness="1"
								HorizontalContentAlignment="Center"
								VerticalContentAlignment="Center"
								ToolTip.Tip="Search Apps">
							<PathIcon Data="{StaticResource SearchGeometry}" Width="16" Height="16" Foreground="White"/>
							<Button.Effect>
								<DropShadowEffect Color="#4169E1" BlurRadius="4" OffsetX="0" OffsetY="0" Opacity="0.2"/>
							</Button.Effect>
						</Button>

						<!-- Keyboard Button -->
						<Button Click="OnKeyboardToggle"
								Width="35"
								Height="30"
								Background="{StaticResource FunctionButtonGradient}"
								Foreground="White"
								CornerRadius="8"
								BorderBrush="#5A7FE1"
								BorderThickness="1"
								HorizontalContentAlignment="Center"
								VerticalContentAlignment="Center"
								ToolTip.Tip="Toggle Keyboard Mode">
							<PathIcon Data="{StaticResource KeyboardGeometry}" Width="16" Height="16" Foreground="White"/>
							<Button.Effect>
								<DropShadowEffect Color="#4169E1" BlurRadius="4" OffsetX="0" OffsetY="0" Opacity="0.2"/>
							</Button.Effect>
						</Button>

						<!-- Info Button -->
						<Button Click="OnInfoClick"
								Width="35"
								Height="30"
								Background="{StaticResource InfoButtonGradient}"
								Foreground="White"
								CornerRadius="8"
								BorderBrush="#1FBBD3"
								BorderThickness="1"
								HorizontalContentAlignment="Center"
								VerticalContentAlignment="Center"
								ToolTip.Tip="Device Information">
							<PathIcon Data="{StaticResource InfoGeometry}" Width="16" Height="16" Foreground="White"/>
							<Button.Effect>
								<DropShadowEffect Color="#17A2B8" BlurRadius="4" OffsetX="0" OffsetY="0" Opacity="0.2"/>
							</Button.Effect>
						</Button>

						<!-- Settings Button -->
						<Button Click="OnSettingsClick"
								Width="35"
								Height="30"
								Background="{StaticResource FunctionButtonGradient}"
								Foreground="White"
								CornerRadius="8"
								BorderBrush="#5A7FE1"
								BorderThickness="1"
								HorizontalContentAlignment="Center"
								VerticalContentAlignment="Center"
								ToolTip.Tip="Settings">
							<PathIcon Data="{StaticResource SettingsGeometry}" Width="16" Height="16" Foreground="White"/>
							<Button.Effect>
								<DropShadowEffect Color="#4169E1" BlurRadius="4" OffsetX="0" OffsetY="0" Opacity="0.2"/>
							</Button.Effect>
						</Button>

						<!-- Remote-Only View Toggle Button -->
						<Button Click="OnToggleRemoteOnlyMode"
								Width="35"
								Height="30"
								Background="{StaticResource FunctionButtonGradient}"
								Foreground="White"
								CornerRadius="8"
								BorderBrush="#5A7FE1"
								BorderThickness="1"
								HorizontalContentAlignment="Center"
								VerticalContentAlignment="Center"
								ToolTip.Tip="{Binding RemoteOnlyToggleTooltip}">
							<PathIcon Data="{StaticResource EyeGeometry}" Width="16" Height="16" Foreground="White"/>
							<Button.Effect>
								<DropShadowEffect Color="#4169E1" BlurRadius="4" OffsetX="0" OffsetY="0" Opacity="0.2"/>
							</Button.Effect>
						</Button>
					</StackPanel>

					<!-- Power Button -->
					<Button Name="PowerButton"
							Click="OnPowerKey"
							Width="45"
							Height="45"
							Background="#FF4757"
							Foreground="White"
							CornerRadius="22"
							HorizontalAlignment="Center"
							HorizontalContentAlignment="Center"
							VerticalContentAlignment="Center"
							Margin="0,0,0,12"
							BorderBrush="#FF6B7A"
							BorderThickness="1"
							ToolTip.Tip="Power On/Off">
						<PathIcon Data="{StaticResource PowerGeometry}" Width="22" Height="22" Foreground="White"/>
						<Button.Effect>
							<DropShadowEffect Color="#FF4757" BlurRadius="6" OffsetX="0" OffsetY="0" Opacity="0.3"/>
						</Button.Effect>
					</Button>

					<!-- Back and Home Row -->
					<StackPanel Orientation="Horizontal" Spacing="40" HorizontalAlignment="Center" Margin="0,0,0,12">
						<Button Click="OnBackKey"
								Width="40"
								Height="32"
								Background="{StaticResource ButtonGradient}"
								Foreground="White"
								CornerRadius="6"
								BorderBrush="#6A6A74"
								BorderThickness="1"
								HorizontalContentAlignment="Center"
								VerticalContentAlignment="Center"
								ToolTip.Tip="Back">
							<PathIcon Data="{StaticResource BackGeometry}" Width="16" Height="16" Foreground="White"/>
						</Button>
						<Button Click="OnHomeKey"
								Width="40"
								Height="32"
								Background="{StaticResource ButtonGradient}"
								Foreground="White"
								CornerRadius="6"
								BorderBrush="#6A6A74"
								BorderThickness="1"
								HorizontalContentAlignment="Center"
								VerticalContentAlignment="Center"
								ToolTip.Tip="Home">
							<PathIcon Data="{StaticResource HomeGeometry}" Width="18" Height="18" Foreground="White"/>
						</Button>
					</StackPanel>

					<!-- D-Pad Navigation -->
					<Grid Width="140" Height="140" HorizontalAlignment="Center" Margin="0,5,0,8">
						<!-- D-Pad Background Circle -->
						<Ellipse Fill="#3A3A44" 
								 Stroke="#2A2A34"
								 StrokeThickness="1"
								 Width="140" Height="140"/>
						
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="*"/>
								<RowDefinition Height="*"/>
								<RowDefinition Height="*"/>
							</Grid.RowDefinitions>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<!-- Up Arrow -->
							<Button Grid.Row="0" Grid.Column="1"
									Click="OnUpKey"
									Width="50"
									Height="32"
									Background="{StaticResource ButtonGradient}"
									Foreground="White"
									CornerRadius="6"
									BorderBrush="#6A6A74"
									BorderThickness="1"
									HorizontalContentAlignment="Center"
									VerticalContentAlignment="Center"
									Margin="0,0,2,0"
									ToolTip.Tip="Up">
								<PathIcon Data="{StaticResource UpGeometry}" Width="18" Height="18" Foreground="White"/>
							</Button>

							<!-- Left Arrow - D-Pad size unchanged -->
							<Button Grid.Row="1" Grid.Column="0"
									Click="OnLeftKey"
									Width="32"
									Height="50"
									Background="{StaticResource ButtonGradient}"
									Foreground="White"
									CornerRadius="6"
									BorderBrush="#6A6A74"
									BorderThickness="1"
									HorizontalContentAlignment="Center"
									VerticalContentAlignment="Center"
									HorizontalAlignment="Right"
									Margin="0,0,5,0"
									ToolTip.Tip="Left">
								<PathIcon Data="{StaticResource LeftGeometry}" Width="18" Height="18" Foreground="White"/>
							</Button>

							<!-- OK Button - D-Pad size unchanged -->
							<Button Grid.Row="1" Grid.Column="1"
									Click="OnSelectKey"
									Width="55"
									Height="55"
									Background="{StaticResource OkButtonGradient}"
									Foreground="White"
									CornerRadius="27"
									BorderBrush="#8A4DC1"
									BorderThickness="2"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									HorizontalContentAlignment="Center"
									VerticalContentAlignment="Center"
									Margin="0"
									ToolTip.Tip="OK / Select">
								<TextBlock Text="OK"
										   FontSize="16"
										   FontWeight="Bold"
										   Foreground="White"
										   HorizontalAlignment="Center"
										   VerticalAlignment="Center"/>
								<Button.Effect>
									<DropShadowEffect Color="#662D91" BlurRadius="4" OffsetX="0" OffsetY="0" Opacity="0.3"/>
								</Button.Effect>
							</Button>

							<!-- Right Arrow - D-Pad size unchanged -->
							<Button Grid.Row="1" Grid.Column="2"
									Click="OnRightKey"
									Width="32"
									Height="50"
									Background="{StaticResource ButtonGradient}"
									Foreground="White"
									CornerRadius="6"
									BorderBrush="#6A6A74"
									BorderThickness="1"
									HorizontalContentAlignment="Center"
									VerticalContentAlignment="Center"
									HorizontalAlignment="Right"
									Margin="0,0,6,0"
									ToolTip.Tip="Right">
								<PathIcon Data="{StaticResource RightGeometry}" Width="18" Height="18" Foreground="White"/>
							</Button>

							<!-- Down Arrow - D-Pad size unchanged -->
							<Button Grid.Row="2" Grid.Column="1"
									Click="OnDownKey"
									Width="50"
									Height="32"
									Background="{StaticResource ButtonGradient}"
									Foreground="White"
									CornerRadius="6"
									BorderBrush="#6A6A74"
									BorderThickness="1"
									HorizontalContentAlignment="Center"
									VerticalContentAlignment="Center"
									Margin="0,0,2,0"
									ToolTip.Tip="Down">
								<PathIcon Data="{StaticResource DownGeometry}" Width="18" Height="18" Foreground="White"/>
							</Button>
						</Grid>
					</Grid>

					<!-- Options and Star Buttons -->
					<StackPanel Orientation="Horizontal" Spacing="25" HorizontalAlignment="Center" Margin="0,5,0,12">
						<Button Click="OnOptionsKey"
								Width="45"
								Height="36"
								Background="{StaticResource ButtonGradient}"
								Foreground="White"
								CornerRadius="5"
								BorderBrush="#6A6A74"
								BorderThickness="1"
								HorizontalContentAlignment="Center"
								VerticalContentAlignment="Center"
								ToolTip.Tip="Menu">
							<PathIcon Data="{StaticResource MenuGeometry}" Width="18" Height="18" Foreground="White"/>
						</Button>
						<!-- Microphone Button -->
						<Button x:Name="MicButton"
								Width="35"
								Height="30"
								Background="{StaticResource FunctionButtonGradient}"
								Foreground="White"
								CornerRadius="8"
								BorderBrush="#5A7FE1"
								BorderThickness="1"
								HorizontalContentAlignment="Center"
								VerticalContentAlignment="Center"
								ToolTip.Tip="Hold to talk (Voice)">
							<PathIcon Data="{StaticResource MicrophoneGeometry}" Width="16" Height="16" Foreground="White"/>
							<Button.Effect>
								<DropShadowEffect Color="#4169E1" BlurRadius="4" OffsetX="0" OffsetY="0" Opacity="0.2"/>
							</Button.Effect>
						</Button>


						<Button Click="OnStarKey"
								Width="45"
								Height="36"
								Background="{StaticResource ButtonGradient}"
								Foreground="White"
								CornerRadius="5"
								BorderBrush="#6A6A74"
								BorderThickness="1"
								HorizontalContentAlignment="Center"
								VerticalContentAlignment="Center"
								ToolTip.Tip="Options (*)">
							<PathIcon Data="{StaticResource StarGeometry}" Width="18" Height="18" Foreground="White"/>
						</Button>
					</StackPanel>

					<!-- Media Control Buttons -->
					<StackPanel Orientation="Horizontal" Spacing="15" HorizontalAlignment="Center" Margin="0,0,0,12">
												<Button Click="OnRewindKey"
								Width="50"
								Height="36"
								Background="{StaticResource ButtonGradient}"
								Foreground="White"
								CornerRadius="6"
								BorderBrush="#6A6A74"
								BorderThickness="1"
								HorizontalContentAlignment="Center"
								VerticalContentAlignment="Center"
								ToolTip.Tip="Rewind">
							<PathIcon Data="{StaticResource RewindGeometry}" Width="18" Height="18" Foreground="White"/>
						</Button>
						<Button Click="OnPlayPauseKey"
								Width="50"
								Height="36"
								Background="{StaticResource ButtonGradient}"
								Foreground="White"
								CornerRadius="6"
								BorderBrush="#6A6A74"
								BorderThickness="1"
								HorizontalContentAlignment="Center"
								VerticalContentAlignment="Center"
								ToolTip.Tip="Play / Pause">
							<PathIcon Data="{StaticResource PlayGeometry}" Width="18" Height="18" Foreground="White"/>
						</Button>
						<Button Click="OnFastForwardKey"
								Width="50"
								Height="36"
								Background="{StaticResource ButtonGradient}"
								Foreground="White"
								CornerRadius="6"
								BorderBrush="#6A6A74"
								BorderThickness="1"
								HorizontalContentAlignment="Center"
								VerticalContentAlignment="Center"
								ToolTip.Tip="Fast Forward">
							<PathIcon Data="{StaticResource FastForwardGeometry}" Width="18" Height="18" Foreground="White"/>
						</Button>
					</StackPanel>

					<!-- Volume Controls -->
					<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,0,0,12">
												<Button Click="OnMuteKey"
									Width="45"
									Height="32"
									Background="{StaticResource ButtonGradient}"
									Foreground="White"
									CornerRadius="5"
									BorderBrush="#6A6A74"
									BorderThickness="1"
									HorizontalContentAlignment="Center"
									VerticalContentAlignment="Center"
									ToolTip.Tip="Mute">
							<PathIcon Data="{StaticResource MuteGeometry}" Width="18" Height="18" Foreground="White"/>
						</Button>
						<Button Click="OnVolumeDownKey"
								Width="48"
								Height="32"
								Background="{StaticResource ButtonGradient}"
								Foreground="White"
								CornerRadius="5"
								BorderBrush="#6A6A74"
								BorderThickness="1"
								HorizontalContentAlignment="Center"
								VerticalContentAlignment="Center"
								ToolTip.Tip="Volume Down">
							<PathIcon Data="{StaticResource VolumeDownGeometry}" Width="18" Height="18" Foreground="White"/>
						</Button>
						<Button Click="OnVolumeUpKey"
								Width="48"
								Height="32"
								Background="{StaticResource ButtonGradient}"
								Foreground="White"
								CornerRadius="5"
								BorderBrush="#6A6A74"
								BorderThickness="1"
								HorizontalContentAlignment="Center"
								VerticalContentAlignment="Center"
								ToolTip.Tip="Volume Up">
							<PathIcon Data="{StaticResource VolumeUpGeometry}" Width="18" Height="18" Foreground="White"/>
						</Button>
					</StackPanel>

					<!-- Customizable Quick Launch Row -->
					<StackPanel Orientation="Vertical" Spacing="5" HorizontalAlignment="Center" Margin="0,8,0,0">
						<!-- Quick Launch Label and Configure Button -->
						<StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
							<TextBlock Text="Quick Launch"
									   FontSize="8"
									   Foreground="#CCCCCC"
									   VerticalAlignment="Center"/>
							<Button Content="⚙"
									Click="OnConfigureQuickLaunch"
									Background="#444444"
									Foreground="White"
									BorderBrush="#666666"
									BorderThickness="1"
									CornerRadius="4"
									Padding="8,4"
									Width="20"
									Height="20"
									FontSize="8"
									HorizontalContentAlignment="Center"
									VerticalContentAlignment="Center"
									ToolTip.Tip="Configure Quick Launch Buttons"/>
						</StackPanel>

						<!-- Quick Launch Buttons Row -->
						<StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
							<Button Name="QuickLaunch1"
									Content="{Binding QuickLaunchButton1Text}"
									Click="OnQuickLaunch1"
									Width="42"
									Height="28"
									FontSize="9"
									FontWeight="Bold"
									Background="{StaticResource QuickLaunchGradient}"
									Foreground="White"
									CornerRadius="3"
									BorderBrush="#FF9C52"
									BorderThickness="1"
									HorizontalContentAlignment="Center"
									VerticalContentAlignment="Center"
									IsVisible="{Binding QuickLaunchButton1Visible}"
									ToolTip.Tip="{Binding QuickLaunchButton1Tooltip}"/>

							<Button Name="QuickLaunch2"
									Content="{Binding QuickLaunchButton2Text}"
									Click="OnQuickLaunch2"
									Width="42"
									Height="28"
									FontSize="9"
									FontWeight="Bold"
									Background="{StaticResource QuickLaunchGradient}"
									Foreground="White"
									CornerRadius="3"
									BorderBrush="#FF9C52"
									BorderThickness="1"
									HorizontalContentAlignment="Center"
									VerticalContentAlignment="Center"
									IsVisible="{Binding QuickLaunchButton2Visible}"
									ToolTip.Tip="{Binding QuickLaunchButton2Tooltip}"/>

							<Button Name="QuickLaunch3"
									Content="{Binding QuickLaunchButton3Text}"
									Click="OnQuickLaunch3"
									Width="42"
									Height="28"
									FontSize="9"
									FontWeight="Bold"
									Background="{StaticResource QuickLaunchGradient}"
									Foreground="White"
									CornerRadius="3"
									BorderBrush="#FF9C52"
									BorderThickness="1"
									HorizontalContentAlignment="Center"
									VerticalContentAlignment="Center"
									IsVisible="{Binding QuickLaunchButton3Visible}"
									ToolTip.Tip="{Binding QuickLaunchButton3Tooltip}"/>

							<Button Name="QuickLaunch4"
									Content="{Binding QuickLaunchButton4Text}"
									Click="OnQuickLaunch4"
									Width="35"
									Height="22"
									FontSize="7"
									FontWeight="Bold"
									Background="{StaticResource QuickLaunchGradient}"
									Foreground="White"
									CornerRadius="3"
									BorderBrush="#FF9C52"
									BorderThickness="1"
									HorizontalContentAlignment="Center"
									VerticalContentAlignment="Center"
									IsVisible="{Binding QuickLaunchButton4Visible}"
									ToolTip.Tip="{Binding QuickLaunchButton4Tooltip}"/>
						</StackPanel>
					</StackPanel>

				</StackPanel>
			</Border>
		</Grid>

			<!-- Apps Panel -->
			<Border Grid.Column="2"
					BorderBrush="Gray"
					BorderThickness="1"
					CornerRadius="10"
					Padding="15"
					IsEnabled="{Binding IsConnected}"
					IsVisible="{Binding !IsRemoteOnlyMode}">
				
				<!-- Single Grid container to hold both views -->
				<Grid>
					<!-- Installed Apps View -->
					<Grid Name="InstalledAppsView" 
						  IsVisible="{Binding ShowInstalledApps}">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>

						<TextBlock Grid.Row="0" 
								   Text="Installed Apps" 
								   FontSize="18" 
								   FontWeight="Bold"
								   Margin="0,0,0,2"/>

						<ListBox Grid.Row="1"
								 ItemsSource="{Binding DeviceApps}"
								 SelectionChanged="OnLaunchApp"
								 ScrollViewer.VerticalScrollBarVisibility="Auto">
							<ListBox.ItemContainerTheme>
								<ControlTheme TargetType="ListBoxItem">
									<Setter Property="Padding" Value="4,2"/>
									<Setter Property="MinHeight" Value="36"/>
									<Setter Property="Height" Value="36"/>
								</ControlTheme>
							</ListBox.ItemContainerTheme>
							<ListBox.ItemTemplate>
								<DataTemplate x:DataType="roku:RokuApp">
									<StackPanel Orientation="Horizontal" Spacing="8" Margin="0">
										<Image Source="{Binding IconImage}"
											   Width="36"
											   Height="36"
											   Stretch="Uniform"
											   VerticalAlignment="Center"/>
										<TextBlock Text="{Binding Name}"
												   VerticalAlignment="Center"
												   FontSize="14"/>
									</StackPanel>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>

						<TextBlock Grid.Row="2" 
								   Text="{Binding RecordingModeInstructions}"
								   FontStyle="Italic"
								   FontSize="12"
								   Foreground="Gray"
								   TextWrapping="Wrap"
								   Margin="0,2,0,0"/>
					</Grid>

					<!-- Quick Launch Configuration View -->
					<StackPanel Name="QuickLaunchConfigView" 
								Spacing="10"
								IsVisible="{Binding ShowQuickLaunchConfig}">
						
						<!-- Header -->
						<TextBlock Text="Configure Quick Launch" 
								   FontSize="18" 
								   FontWeight="Bold"
								   HorizontalAlignment="Center"/>

						<ScrollViewer MaxHeight="450" VerticalScrollBarVisibility="Auto">
							<StackPanel Spacing="15">
								<TextBlock Text="Set up to 4 quick launch buttons with custom action sequences:"
										   FontSize="12"
										   TextWrapping="Wrap"/>

								<!-- Button 1 Configuration -->
								<Border Background="#2A2A2A" CornerRadius="8" Padding="10">
									<StackPanel Spacing="8">
										<CheckBox Name="QuickLaunch1EnabledCB"
												  Content="Button 1 Enabled"
												  IsChecked="{Binding QuickLaunchButton1Visible}"
												  FontSize="12" FontWeight="Bold"/>
										<Grid ColumnDefinitions="Auto,*">
											<TextBlock Grid.Column="0" Text="Label:" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
											<TextBox Grid.Column="1"
													 Name="QuickLaunch1TextTB"
													 Text="{Binding QuickLaunchButton1Text}"
													 FontSize="11"
													 Watermark="Button text"/>
										</Grid>
										
										<Grid ColumnDefinitions="Auto,*,Auto,Auto">
											<TextBlock Grid.Column="0" Text="Actions:" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
											<TextBlock Grid.Column="1"
													   Text="{Binding QuickLaunchButton1Summary}"
													   FontSize="10"
													   Foreground="#CCCCCC"
													   VerticalAlignment="Center"
													   TextWrapping="Wrap"/>
											<Button Grid.Column="2"
													Click="OnReviewButton1"
													Background="{StaticResource ReviewGradient}"
													Foreground="White"
													BorderThickness="0"
													CornerRadius="4"
													Padding="6,4"
													FontSize="9"
													FontWeight="Bold"
													Margin="0,0,4,0"
													HorizontalContentAlignment="Center"
													VerticalContentAlignment="Center"
													ToolTip.Tip="Review and edit actions"
													IsEnabled="{Binding QuickLaunchButton1HasActions}">
												<StackPanel Orientation="Horizontal" Spacing="4">
													<PathIcon Data="{StaticResource EyeGeometry}" Width="10" Height="10" Foreground="White"/>
													<TextBlock Text="Review" VerticalAlignment="Center"/>
												</StackPanel>
											</Button>
											<Button Grid.Column="3"
													Click="OnRecordButton1"
													Background="{StaticResource RecordGradient}"
													Foreground="White"
													BorderThickness="0"
													CornerRadius="4"
													Padding="6,4"
													FontSize="9"
													FontWeight="Bold"
													HorizontalContentAlignment="Center"
													VerticalContentAlignment="Center"
													ToolTip.Tip="Record action sequence">
												<StackPanel Orientation="Horizontal" Spacing="4">
													<PathIcon Data="{StaticResource RecordGeometry}" Width="10" Height="10" Foreground="White"/>
													<TextBlock Text="REC" VerticalAlignment="Center"/>
												</StackPanel>
											</Button>
										</Grid>
									</StackPanel>
								</Border>

								<!-- Button 2 Configuration -->
								<Border Background="#2A2A2A" CornerRadius="8" Padding="10">
									<StackPanel Spacing="8">
										<CheckBox Name="QuickLaunch2EnabledCB"
												  Content="Button 2 Enabled"
												  IsChecked="{Binding QuickLaunchButton2Visible}"
												  FontSize="12" FontWeight="Bold"/>
										<Grid ColumnDefinitions="Auto,*">
											<TextBlock Grid.Column="0" Text="Label:" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
											<TextBox Grid.Column="1"
													 Name="QuickLaunch2TextTB"
													 Text="{Binding QuickLaunchButton2Text}"
													 FontSize="11"
													 Watermark="Button text"/>
										</Grid>
										
										<Grid ColumnDefinitions="Auto,*,Auto,Auto">
											<TextBlock Grid.Column="0" Text="Actions:" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
											<TextBlock Grid.Column="1"
													   Text="{Binding QuickLaunchButton2Summary}"
													   FontSize="10"
													   Foreground="#CCCCCC"
													   VerticalAlignment="Center"
													   TextWrapping="Wrap"/>
											<Button Grid.Column="2"
													Click="OnReviewButton2"
													Background="{StaticResource ReviewGradient}"
													Foreground="White"
													BorderThickness="0"
													CornerRadius="4"
													Padding="6,4"
													FontSize="9"
													FontWeight="Bold"
													Margin="0,0,4,0"
													HorizontalContentAlignment="Center"
													VerticalContentAlignment="Center"
													ToolTip.Tip="Review and edit actions"
													IsEnabled="{Binding QuickLaunchButton2HasActions}">
												<StackPanel Orientation="Horizontal" Spacing="4">
													<PathIcon Data="{StaticResource EyeGeometry}" Width="10" Height="10" Foreground="White"/>
													<TextBlock Text="Review" VerticalAlignment="Center"/>
												</StackPanel>
											</Button>
											<Button Grid.Column="3"
													Click="OnRecordButton2"
													Background="{StaticResource RecordGradient}"
													Foreground="White"
													BorderThickness="0"
													CornerRadius="4"
													Padding="6,4"
													FontSize="9"
													FontWeight="Bold"
													HorizontalContentAlignment="Center"
													VerticalContentAlignment="Center"
													ToolTip.Tip="Record action sequence">
												<StackPanel Orientation="Horizontal" Spacing="4">
													<PathIcon Data="{StaticResource RecordGeometry}" Width="10" Height="10" Foreground="White"/>
													<TextBlock Text="REC" VerticalAlignment="Center"/>
												</StackPanel>
											</Button>
										</Grid>
									</StackPanel>
								</Border>

								<!-- Button 3 Configuration -->
								<Border Background="#2A2A2A" CornerRadius="8" Padding="10">
									<StackPanel Spacing="8">
										<CheckBox Name="QuickLaunch3EnabledCB"
												  Content="Button 3 Enabled"
												  IsChecked="{Binding QuickLaunchButton3Visible}"
												  FontSize="12" FontWeight="Bold"/>
										<Grid ColumnDefinitions="Auto,*">
											<TextBlock Grid.Column="0" Text="Label:" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
											<TextBox Grid.Column="1"
													 Name="QuickLaunch3TextTB"
													 Text="{Binding QuickLaunchButton3Text}"
													 FontSize="11"
													 Watermark="Button text"/>
										</Grid>
										
										<Grid ColumnDefinitions="Auto,*,Auto,Auto">
											<TextBlock Grid.Column="0" Text="Actions:" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
											<TextBlock Grid.Column="1"
													   Text="{Binding QuickLaunchButton3Summary}"
													   FontSize="10"
													   Foreground="#CCCCCC"
													   VerticalAlignment="Center"
													   TextWrapping="Wrap"/>
											<Button Grid.Column="2"
													Click="OnReviewButton3"
													Background="{StaticResource ReviewGradient}"
													Foreground="White"
													BorderThickness="0"
													CornerRadius="4"
													Padding="6,4"
													FontSize="9"
													FontWeight="Bold"
													Margin="0,0,4,0"
													HorizontalContentAlignment="Center"
													VerticalContentAlignment="Center"
													ToolTip.Tip="Review and edit actions"
													IsEnabled="{Binding QuickLaunchButton3HasActions}">
												<StackPanel Orientation="Horizontal" Spacing="4">
													<PathIcon Data="{StaticResource EyeGeometry}" Width="10" Height="10" Foreground="White"/>
													<TextBlock Text="Review" VerticalAlignment="Center"/>
												</StackPanel>
											</Button>
											<Button Grid.Column="3"
													Click="OnRecordButton3"
													Background="{StaticResource RecordGradient}"
													Foreground="White"
													BorderThickness="0"
													CornerRadius="4"
													Padding="6,4"
													FontSize="9"
													FontWeight="Bold"
													HorizontalContentAlignment="Center"
													VerticalContentAlignment="Center"
													ToolTip.Tip="Record action sequence">
												<StackPanel Orientation="Horizontal" Spacing="4">
													<PathIcon Data="{StaticResource RecordGeometry}" Width="10" Height="10" Foreground="White"/>
													<TextBlock Text="REC" VerticalAlignment="Center"/>
												</StackPanel>
											</Button>
										</Grid>
									</StackPanel>
								</Border>

								<!-- Button 4 Configuration -->
								<Border Background="#2A2A2A" CornerRadius="8" Padding="10">
									<StackPanel Spacing="8">
										<CheckBox Name="QuickLaunch4EnabledCB"
												  Content="Button 4 Enabled"
												  IsChecked="{Binding QuickLaunchButton4Visible}"
												  FontSize="12" FontWeight="Bold"/>
										<Grid ColumnDefinitions="Auto,*">
											<TextBlock Grid.Column="0" Text="Label:" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
											<TextBox Grid.Column="1"
													 Name="QuickLaunch4TextTB"
													 Text="{Binding QuickLaunchButton4Text}"
													 FontSize="11"
													 Watermark="Button text"/>
										</Grid>
										
										<Grid ColumnDefinitions="Auto,*,Auto,Auto">
											<TextBlock Grid.Column="0" Text="Actions:" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
											<TextBlock Grid.Column="1"
													   Text="{Binding QuickLaunchButton4Summary}"
													   FontSize="10"
													   Foreground="#CCCCCC"
													   VerticalAlignment="Center"
													   TextWrapping="Wrap"/>
											<Button Grid.Column="2"
													Click="OnReviewButton4"
													Background="{StaticResource ReviewGradient}"
													Foreground="White"
													BorderThickness="0"
													CornerRadius="4"
													Padding="6,4"
													FontSize="9"
													FontWeight="Bold"
													Margin="0,0,4,0"
													HorizontalContentAlignment="Center"
													VerticalContentAlignment="Center"
													ToolTip.Tip="Review and edit actions"
													IsEnabled="{Binding QuickLaunchButton4HasActions}">
												<StackPanel Orientation="Horizontal" Spacing="4">
													<PathIcon Data="{StaticResource EyeGeometry}" Width="10" Height="10" Foreground="White"/>
													<TextBlock Text="Review" VerticalAlignment="Center"/>
												</StackPanel>
											</Button>
											<Button Grid.Column="3"
													Click="OnRecordButton4"
													Background="{StaticResource RecordGradient}"
													Foreground="White"
													BorderThickness="0"
													CornerRadius="4"
													Padding="6,4"
													FontSize="9"
													FontWeight="Bold"
													HorizontalContentAlignment="Center"
													VerticalContentAlignment="Center"
													ToolTip.Tip="Record action sequence">
												<StackPanel Orientation="Horizontal" Spacing="4">
													<PathIcon Data="{StaticResource RecordGeometry}" Width="10" Height="10" Foreground="White"/>
													<TextBlock Text="REC" VerticalAlignment="Center"/>
												</StackPanel>
											</Button>
										</Grid>
									</StackPanel>
								</Border>
							</StackPanel>
						</ScrollViewer>

						<!-- Action Buttons -->
						<StackPanel Orientation="Horizontal" Spacing="15" HorizontalAlignment="Center" Margin="0,15,0,0">
							<Button Content="Save and Return"
									Click="OnSaveQuickLaunchConfig"
									Background="#5CB85C"
									Foreground="White"
									BorderBrush="#4CAE4C"
									BorderThickness="1"
									CornerRadius="4"
									Padding="20,8"
									FontSize="12"
									HorizontalContentAlignment="Center"
									VerticalContentAlignment="Center"
									ToolTip.Tip="Save configuration and return"/>
							<Button Content="Cancel"
									Click="OnCancelQuickLaunchConfig"
									Background="#D9534F"
									Foreground="White"
									BorderBrush="#D43F3A"
									BorderThickness="1"
									CornerRadius="4"
									Padding="20,8"
									FontSize="12"
									HorizontalContentAlignment="Center"
									VerticalContentAlignment="Center"
									ToolTip.Tip="Discard changes"/>
						</StackPanel>
					</StackPanel>
				</Grid>
			</Border>
		</Grid>

		<!-- Recording Dialog - Moved to top-left of entire window -->
		<Border Grid.Row="0" Grid.RowSpan="2"
				HorizontalAlignment="Left"
				VerticalAlignment="Top"
				Margin="10,120,0,0"
				IsVisible="{Binding IsRecording}"
				IsHitTestVisible="True"
				ZIndex="2000">
			<Border Background="#1A1A24" 
					BorderBrush="#FF2C2C" 
					BorderThickness="2" 
					CornerRadius="10" 
					Padding="12">
				<Border.Effect>
					<DropShadowEffect Color="#FF2C2C" BlurRadius="8" OffsetX="2" OffsetY="2" Opacity="0.5"/>
				</Border.Effect>
				
				<StackPanel Spacing="8" Width="200">
					<!-- Recording Header -->
					<StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
						<TextBlock Text="●" FontSize="10" Foreground="#FF2C2C" VerticalAlignment="Center"/>
						<TextBlock Text="RECORDING" 
								   FontSize="10" 
								   FontWeight="Bold" 
								   Foreground="#FF2C2C"
								   VerticalAlignment="Center"/>
						<TextBlock Text="{Binding RecordingStatusText}" 
								   FontSize="9" 
								   Foreground="White"
								   VerticalAlignment="Center"/>
					</StackPanel>
					
					<!-- Action Count -->
					<TextBlock Text="{Binding RecordedActionsText}" 
							   FontSize="9" 
							   TextWrapping="Wrap"
							   HorizontalAlignment="Center" 
							   TextAlignment="Center"
							   Foreground="#CCCCCC"/>
					
					<!-- Action Buttons -->
					<StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Margin="0,4,0,0">
						<Button Content="✓ Save"
								Click="OnSaveRecording"
								Background="#5CB85C"
								Foreground="White"
								BorderThickness="0"
								CornerRadius="4"
								Padding="10,3"
								FontSize="9"
								FontWeight="Bold"
								HorizontalContentAlignment="Center"
								VerticalContentAlignment="Center"/>
						<Button Content="✗ Cancel"
								Click="OnCancelRecording"
								Background="#D9534F"
								Foreground="White"
								BorderThickness="0"
								CornerRadius="4"
								Padding="10,3"
								FontSize="9"
								FontWeight="Bold"
								HorizontalContentAlignment="Center"
								VerticalContentAlignment="Center"/>
					</StackPanel>
				</StackPanel>
			</Border>
		</Border>
		</Grid>
	</dialogHostAvalonia:DialogHost>
</Window>