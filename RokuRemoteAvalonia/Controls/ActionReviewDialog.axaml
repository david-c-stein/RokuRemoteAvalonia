<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:RokuRemoteAvalonia.Models"
             xmlns:controls="using:RokuRemoteAvalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="400"
             x:Class="RokuRemoteAvalonia.Controls.ActionReviewDialog"
             x:DataType="controls:ActionReviewDialog">

    <Border Background="#2B2B35" 
            BorderBrush="#3A3A44" 
            BorderThickness="2" 
            CornerRadius="12" 
            Padding="20"
            MinWidth="450"
            MaxWidth="600">
        <StackPanel Spacing="15">
            
            <!-- Header -->
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <TextBlock Text="👁" FontSize="16" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Title}" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Foreground="White"
                           VerticalAlignment="Center"/>
            </StackPanel>
            
            <!-- Actions List -->
            <Border Background="#1A1A24" 
                    BorderBrush="#4A4A54" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="10">
                <StackPanel Spacing="10">
                    <TextBlock Text="Action Sequence:" 
                               FontSize="12" 
                               FontWeight="Bold" 
                               Foreground="White"/>
                    
                    <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Actions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="controls:QuickLaunchActionViewModel">
                                    <Border Background="#2A2A2A" 
                                            CornerRadius="6" 
                                            Padding="10" 
                                            Margin="0,2">
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
                                            <!-- Step Number -->
                                            <Border Grid.Column="0"
                                                    Background="#4A90E2"
                                                    CornerRadius="10"
                                                    Width="20" Height="20"
                                                    Margin="0,0,8,0">
                                                <TextBlock Text="{Binding StepNumber}" 
                                                           FontSize="10" 
                                                           FontWeight="Bold"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            
                                            <!-- Action Icon -->
                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding TypeIcon}" 
                                                       FontSize="14" 
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>
                                            
                                            <!-- Action Description -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" 
                                                           FontSize="11" 
                                                           FontWeight="Bold"
                                                           Foreground="White"/>
                                                <TextBlock Text="{Binding ActionDetails}" 
                                                           FontSize="9" 
                                                           Foreground="#CCCCCC"
                                                           IsVisible="{Binding HasDetails}"/>
                                            </StackPanel>
                                            
                                            <!-- Move Up Button -->
                                            <Button Grid.Column="3"
                                                    Content="↑"
                                                    Click="OnMoveUpAction"
                                                    CommandParameter="{Binding}"
                                                    Background="#555555"
                                                    Foreground="White"
                                                    BorderThickness="0"
                                                    CornerRadius="3"
                                                    Width="24" Height="24"
                                                    FontSize="10"
                                                    Margin="4,0,2,0"
                                                    ToolTip.Tip="Move up"
                                                    IsEnabled="{Binding CanMoveUp}"/>
                                            
                                            <!-- Move Down Button -->
                                            <Button Grid.Column="4"
                                                    Content="↓"
                                                    Click="OnMoveDownAction"
                                                    CommandParameter="{Binding}"
                                                    Background="#555555"
                                                    Foreground="White"
                                                    BorderThickness="0"
                                                    CornerRadius="3"
                                                    Width="24" Height="24"
                                                    FontSize="10"
                                                    Margin="2,0,2,0"
                                                    ToolTip.Tip="Move down"
                                                    IsEnabled="{Binding CanMoveDown}"/>
                                            
                                            <!-- Delete Button -->
                                            <Button Grid.Column="5"
                                                    Content="🗑"
                                                    Click="OnDeleteAction"
                                                    CommandParameter="{Binding}"
                                                    Background="#D9534F"
                                                    Foreground="White"
                                                    BorderThickness="0"
                                                    CornerRadius="3"
                                                    Width="24" Height="24"
                                                    FontSize="10"
                                                    Margin="2,0,0,0"
                                                    ToolTip.Tip="Delete action"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    
                    <!-- Empty State -->
                    <TextBlock Text="No actions recorded yet. Use the Record button to add actions to this sequence." 
                               FontSize="11" 
                               FontStyle="Italic"
                               Foreground="#888888"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               IsVisible="{Binding IsEmpty}"/>
                </StackPanel>
            </Border>
            
            <!-- Action Summary -->
            <TextBlock Text="{Binding ActionsSummary}" 
                       FontSize="10" 
                       Foreground="#CCCCCC"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
            
            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                <Button Content="🗑 Clear All"
                        Click="OnClearAllActions"
                        Background="#D9534F"
                        Foreground="White"
                        BorderThickness="0"
                        CornerRadius="6"
                        Padding="12,6"
                        FontSize="11"
                        FontWeight="Bold"
                        IsEnabled="{Binding HasActions}"/>
                
                <Button Content="▶ Test Sequence"
                        Click="OnTestSequence"
                        Background="#FF8C42"
                        Foreground="White"
                        BorderThickness="0"
                        CornerRadius="6"
                        Padding="12,6"
                        FontSize="11"
                        FontWeight="Bold"
                        IsEnabled="{Binding HasActions}"/>
                
                <Button Content="✓ Save Changes"
                        Click="OnSaveChanges"
                        Background="#5CB85C"
                        Foreground="White"
                        BorderThickness="0"
                        CornerRadius="6"
                        Padding="12,6"
                        FontSize="11"
                        FontWeight="Bold"/>
                
                <Button Content="✗ Cancel"
                        Click="OnCancelChanges"
                        Background="#6C757D"
                        Foreground="White"
                        BorderThickness="0"
                        CornerRadius="6"
                        Padding="12,6"
                        FontSize="11"
                        FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>